<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#334155" padding="0" />
      <mj-button background-color="#0F766E" color="#FFFFFF" border-radius="8px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section padding="32px 24px 8px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#0F766E" align="center">Waland</mj-text>
        <mj-text font-size="13px" color="#64748B" align="center" padding-top="4px">WhatsApp Messaging API</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column background-color="#FFFFFF" border-radius="12px" padding="28px 24px">
        <mj-text font-size="22px" font-weight="700" color="#0F172A" padding-bottom="16px">
          You're invited to join {{organizationName}}
        </mj-text>
        <mj-text padding-bottom="12px">Hi,</mj-text>
        <mj-text padding-bottom="16px">
          {{inviterName}} invited you to join <strong>{{organizationName}}</strong> on Waland as a <strong>{{role}}</strong>.
        </mj-text>
        <mj-text padding-bottom="20px">
          Accept the invitation to manage WhatsApp sessions and message logs with your team.
        </mj-text>
        <mj-button href="{{acceptUrl}}" padding="14px 28px">Accept invitation</mj-button>
        <mj-text padding-top="20px" font-size="14px" color="#64748B">
          Or copy this link into your browser:<br />
          <a href="{{acceptUrl}}" style="color:#0F766E">{{acceptUrl}}</a>
        </mj-text>
        <mj-text padding-top="20px" font-size="14px" color="#64748B">
          This invitation expires on {{expiresAt}}. Sign in with <strong>{{inviteeEmail}}</strong> to accept.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#94A3B8" align="center">
          If you were not expecting this invitation, you can ignore this email.
        </mj-text>
        <mj-text font-size="12px" color="#94A3B8" align="center" padding-top="8px">
          Waland · <a href="{{consoleUrl}}" style="color:#64748B">{{consoleUrl}}</a> ·
          <a href="mailto:{{supportEmail}}" style="color:#64748B">{{supportEmail}}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
