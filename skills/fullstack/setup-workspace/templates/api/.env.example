PORT=4001
NODE_ENV=development
APP_NAME=Your App

MONGODB_URI=mongodb://localhost:27017/<project>

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4001

TRUSTED_ORIGINS=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
AUTH_DISABLE_CSRF_CHECK=true

# OAuth (optional — set both ID and secret per provider)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMTP (optional — required together when MAIL_HOST is set)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_CONSOLE_URL=http://localhost:5173
# MAIL_SUPPORT_EMAIL=

# REDIS_URL=redis://localhost:6379
