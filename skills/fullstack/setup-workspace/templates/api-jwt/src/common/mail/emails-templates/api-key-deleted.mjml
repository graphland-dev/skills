<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#334155" padding="0" />
      <mj-button background-color="#0F766E" color="#FFFFFF" border-radius="8px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F8FAFC">
    <mj-section padding="32px 24px 8px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#0F766E" align="center">{{appName}}</mj-text>
        <mj-text font-size="13px" color="#64748B" align="center" padding-top="4px">WhatsApp Messaging API</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column background-color="#FFFFFF" border-radius="12px" padding="28px 24px">
        <mj-text font-size="22px" font-weight="700" color="#0F172A" padding-bottom="16px">
          API key deleted
        </mj-text>
        <mj-text padding-bottom="12px">Hi {{ownerName}},</mj-text>
        <mj-text padding-bottom="16px">
          An API key was deleted for <strong>{{organizationName}}</strong>.
        </mj-text>
        <mj-text padding-bottom="8px"><strong>Name:</strong> {{apiKeyName}}</mj-text>
        <mj-text padding-bottom="8px"><strong>Key prefix:</strong> {{keyPrefix}}</mj-text>
        <mj-text padding-bottom="8px"><strong>Deleted by:</strong> {{actorName}} ({{actorEmail}})</mj-text>
        <mj-text padding-bottom="20px">
          If you did not expect this change, review your organization members and rotate any remaining keys.
        </mj-text>
        <mj-button href="{{apiKeysUrl}}" padding="14px 28px">Manage API keys</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="8px 24px 32px">
      <mj-column>
        <mj-text font-size="12px" color="#94A3B8" align="center">
          This is an automated security notification for organization owners.
        </mj-text>
        <mj-text font-size="12px" color="#94A3B8" align="center" padding-top="8px">
          {{appName}} · <a href="{{consoleUrl}}" style="color:#64748B">{{consoleUrl}}</a> ·
          <a href="mailto:{{supportEmail}}" style="color:#64748B">{{supportEmail}}</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
